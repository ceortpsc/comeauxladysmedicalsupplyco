APP_ENV=development
APP_VERSION=0.1.0
DATABASE_URL=
SESSION_SECRET=
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000

# Commerce / Stripe adapter
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI simulation provider; scripted works without an external key
AI_PROVIDER=scripted
AI_PROVIDER_API_KEY=

# Google Cloud release plane
GCP_PROJECT_ID=
GCP_API_HUB_PROJECT=
GCP_API_HUB_LOCATION=us-central1
GCP_ARTIFACT_LOCATION=us-central1

# External regulatory handoff metadata. No public direct-write TULIP API is assumed.
TULIP_HANDOFF_MODE=assisted-manual

# Supabase primary data plane
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
