{
  "platform": "comeaux-ladys-medical-supply-platform",
  "version": "0.3.0",
  "artifacts": [
    {
      "name": "platform-web",
      "type": "nextjs-standalone",
      "source": "apps/platform",
      "immutable": true
    },
    {
      "name": "platform-openapi",
      "type": "openapi",
      "source": "contracts/comeaux-platform.openapi.yaml",
      "immutable": true
    },
    {
      "name": "internal-external-gateway-openapi",
      "type": "openapi",
      "source": "contracts/internal-external-gateway.openapi.yaml",
      "immutable": true
    },
    {
      "name": "internal-external-adapter-registry",
      "type": "integration-registry",
      "source": "config/internal-external-adapters.json",
      "immutable": true
    },
    {
      "name": "internal-external-gateway-code",
      "type": "typescript-package",
      "source": "packages/external-gateway",
      "immutable": true
    },
    {
      "name": "ios-app",
      "type": "ios-xcarchive",
      "source": "mobile/ios",
      "immutable": true
    },
    {
      "name": "database-schema",
      "type": "sql",
      "source": "db/001_platform.sql",
      "immutable": true
    },
    {
      "name": "production-control-schema",
      "type": "sql",
      "source": "db/002_production_control_plane.sql",
      "immutable": true
    },
    {
      "name": "brand-logo",
      "type": "svg",
      "source": "apps/platform/public/brand/logo.svg",
      "immutable": true
    },
    {
      "name": "data-entry-engine",
      "type": "typescript-package",
      "source": "packages/data-entry",
      "immutable": true
    },
    {
      "name": "andreaa-ai-governance",
      "type": "typescript-package",
      "source": "packages/ai-core",
      "immutable": true
    },
    {
      "name": "implementation-environment",
      "type": "environment-manifest",
      "source": "config/implementation-environment.json",
      "immutable": true
    },
    {
      "name": "implementation-grade-report",
      "type": "governance-document",
      "source": "docs/IMPLEMENTATION_GRADE_ENVIRONMENT.md",
      "immutable": true
    },
    {
      "name": "catalog-product-assets",
      "type": "product-media",
      "source": "apps/platform/public/products",
      "immutable": true
    }
  ],
  "releaseGates": [
    "typecheck",
    "next-build",
    "api-contract-present",
    "integration-registry-present",
    "zero-cost-policy",
    "database-schema-reviewed",
    "runtime-self-test",
    "staging-health",
    "manual-production-approval"
  ]
}
